    {
      "id": "oxc-rules-generated-companions",
      "description": "Oxc source rule registry changes almost always travel with the two generated Rust registries.",
      "repository": "https://github.com/oxc-project/oxc.git",
      "checkout": "8783524015b1e6ff1c39ccf426df0bb07cbbc588",
      "command": [
        "history",
        "--max-commits",
        "100",
        "--format",
        "json",
        "crates/oxc_linter/src/rules.rs"
      ],
      "expect": {
        "analysis": "historical_companions",
        "companions": [
          {
            "path": "crates/oxc_linter/src/generated/rule_runner_impls.rs",
            "min_support": 99,
            "opportunities": 100
          },
          {
            "path": "crates/oxc_linter/src/generated/rules_enum.rs",
            "min_support": 99,
            "opportunities": 100
          }
        ]
      }
    },
