      "repository": "https://github.com/cloud-hypervisor/cloud-hypervisor.git",
      "checkout": "439ff52249e819f41570a5f3f3bf535d4bfb3e6e",
      "extra_refs": [
        "1b004a7459ac752e1d7ad5a48237a1cb8608003b"
      ],
      "command": [
        "diff",
        "--base",
        "1b004a7459ac752e1d7ad5a48237a1cb8608003b",
